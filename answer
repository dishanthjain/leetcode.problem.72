class Solution {
public:
    string simplifyPath(string path) {
        stack<string> st;
        stringstream ss(path);
        string part;

        while (getline(ss, part, '/')) {
            if (part.empty() || part == ".")
                continue;

            if (part == "..") {
                if (!st.empty())
                    st.pop();
            } else {
                st.push(part);
            }
        }

        string result;

        while (!st.empty()) {
            result = "/" + st.top() + result;
            st.pop();
        }

        return result.empty() ? "/" : result;
    }
};

Explanation:

We split the path into directory names and use a stack to manage them. We ignore . and empty parts, remove the last directory for .., and push valid directory names. Finally, we build the simplified path from the stack.
